{
  "info": {
    "name": "Sinkronis Auth + Admin Module",
    "description": "Previously tested Auth module collection, now extended with Tenant Admin dashboard and organization endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": {
      "major": 1,
      "minor": 1,
      "patch": 0
    }
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "apiPrefix", "value": "/api/v1" },
    { "key": "organizationSlug", "value": "acme-logistics" },
    { "key": "adminEmail", "value": "owner@acme.com" },
    { "key": "adminPassword", "value": "Password123!" },
    { "key": "accessToken", "value": "" },
    { "key": "departmentId", "value": "" },
    { "key": "branchId", "value": "" },
    { "key": "roleId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "invitationId", "value": "" },
    { "key": "groupId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationSlug\": \"{{organizationSlug}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body?.tokens?.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', body.tokens.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationSlug\": \"{{organizationSlug}}\",\n  \"email\": \"{{adminEmail}}\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/forgot-password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin Dashboard + Organization",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Organization",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/organization"
          }
        },
        {
          "name": "Update Organization",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"industry\": \"Technology\",\n  \"companySize\": \"5 - 10\",\n  \"fiscalYearStart\": \"01-01\",\n  \"website\": \"https://example.com\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/admin/organization"
          }
        },
        {
          "name": "Get Work Schedule",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/organization/work-schedule"
          }
        },
        {
          "name": "Save Work Schedule",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monday\": true,\n  \"tuesday\": true,\n  \"wednesday\": true,\n  \"thursday\": true,\n  \"friday\": true,\n  \"saturday\": false,\n  \"sunday\": false,\n  \"workStartTime\": \"09:00\",\n  \"workEndTime\": \"17:00\",\n  \"breakDurationMinutes\": 60\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/admin/organization/work-schedule"
          }
        },
        {
          "name": "Departments Table",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/departments/table?page=1&limit=25"
          }
        },
        {
          "name": "Create Department",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering\",\n  \"description\": \"Core engineering team\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/admin/departments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body?.id) pm.collectionVariables.set('departmentId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Department",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated department description\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/admin/departments/{{departmentId}}"
          }
        },
        {
          "name": "Branches Table",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/branches/table?page=1&limit=25"
          }
        },
        {
          "name": "Create Branch",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Head Office\",\n  \"address\": \"12 Marina, Lagos\",\n  \"phone\": \"+2348012345678\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/admin/branches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body?.id) pm.collectionVariables.set('branchId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Branch",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"20 Broad Street, Lagos\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/admin/branches/{{branchId}}"
          }
        },
        {
          "name": "Delete Branch",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/branches/{{branchId}}"
          }
        },
        {
          "name": "Delete Department",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/departments/{{departmentId}}"
          }
        }
      ]
    },
    {
      "name": "Admin User Management",
      "item": [
        {
          "name": "Get Roles",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/roles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (Array.isArray(body) && body.length > 0 && body[0]?.id) {",
                  "  pm.collectionVariables.set('roleId', body[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Users Analytics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/users/analytics"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/users?page=1&limit=25"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (Array.isArray(body?.data) && body.data.length > 0 && body.data[0]?.id) {",
                  "  pm.collectionVariables.set('userId', body.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update User Access",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleId\": \"{{roleId}}\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/admin/users/{{userId}}"
          }
        },
        {
          "name": "Invite User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.user+{{organizationSlug}}@example.com\",\n  \"roleId\": \"{{roleId}}\",\n  \"moduleAccess\": [\"HRIS\"]\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/admin/users/invitations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body?.id) pm.collectionVariables.set('invitationId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Pending Invitations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/users/invitations?page=1&limit=25&status=PENDING"
          }
        },
        {
          "name": "Resend Invitation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/users/invitations/{{invitationId}}/resend"
          }
        },
        {
          "name": "List User Groups",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/users/groups?page=1&limit=25"
          }
        },
        {
          "name": "Create User Group",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Operations Function\",\n  \"type\": \"FUNCTION\",\n  \"description\": \"Operations user group\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/admin/users/groups"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body?.id) pm.collectionVariables.set('groupId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update User Group",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated operations group\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/admin/users/groups/{{groupId}}"
          }
        },
        {
          "name": "Delete User Group",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/admin/users/groups/{{groupId}}"
          }
        }
      ]
    }
  ]
}
