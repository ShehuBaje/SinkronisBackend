NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@TIDB_HOST:4000/DATABASE_NAME?sslaccept=strict
API_PREFIX=/api/v1
APP_TOKEN_NAME=sinkronis-token
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=
RATE_LIMIT_STORE=memory
BACKGROUND_JOBS_MODE=queue
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
APP_NAME=Sinkronis
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
AUTH_ENFORCE_UNIQUE_EMAIL=true
# Comma-separated exact origins. Production example: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Canonical public API origin used when generating local-storage asset URLs.
PUBLIC_BASE_URL=http://localhost:3000
# Number of explicitly trusted reverse-proxy hops. Keep 0 for direct connections.
TRUST_PROXY_HOPS=0
TRUST_PROXY_CIDRS=
# Optional public-IP geolocation. Authentication never depends on this service.
IP_GEOLOCATION_PROVIDER=NONE
IPINFO_TOKEN=
IP_GEOLOCATION_TIMEOUT_MS=1500
# Development/test only; forbidden by configuration validation in production.
DEV_CLIENT_IP_OVERRIDE=
# CAC VAS remains unavailable until the account-specific endpoint contract is supplied.
COMPANY_REGISTRY_PROVIDER=NONE
# Production: https://vasapp.cac.gov.ng; staging: https://vasapp.oasisproducts.ng
CAC_API_BASE_URL=https://vasapp.cac.gov.ng
CAC_API_KEY=
CAC_API_TIMEOUT_MS=5000
# Paystack values must be configured in the deployment secret store, never committed.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/accounting/wallet/funding/callback
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=
# Migration-only. CROSS_STORE requires both tokens; SAME_STORE explicitly reuses BLOB_READ_WRITE_TOKEN.
PRIVATE_FILE_MIGRATION_MODE=
SOURCE_BLOB_READ_WRITE_TOKEN=
DESTINATION_BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_PATH=/uploads
UPLOAD_MAX_FILE_SIZE_MB=5
DEFAULT_SUPER_ADMIN_EMAIL=admin@example.com
DEFAULT_SUPER_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
