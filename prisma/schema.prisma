generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AgentInvitation {
  id              String                 @id @default(cuid())
  organizationId  String
  email           String
  token           String                 @unique(map: "AgentInvitation_token_key")
  status          agentinvitation_status @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  roleId          String?
  invitedByUserId String?
  moduleAccess    Json?
  user            User?                  @relation(fields: [invitedByUserId], references: [id], map: "AgentInvitation_invitedByUserId_fkey")
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AgentInvitation_organizationId_fkey")
  role            Role?                  @relation(fields: [roleId], references: [id], map: "AgentInvitation_roleId_fkey")

  @@index([invitedByUserId], map: "AgentInvitation_invitedByUserId_fkey")
  @@index([organizationId, roleId], map: "AgentInvitation_organizationId_roleId_idx")
  @@index([organizationId, status], map: "AgentInvitation_organizationId_status_idx")
  @@index([roleId], map: "AgentInvitation_roleId_fkey")
  @@map("AgentInvitation")
}

model AnnouncementReadStatus {
  id                   String               @id @default(cuid())
  organizationId       String
  userId               String
  announcementId       String
  readAt               DateTime             @default(now())
  createdAt            DateTime             @default(now())
  platformannouncement PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade, map: "AnnouncementReadStatus_announcementId_fkey")
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AnnouncementReadStatus_organizationId_fkey")
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade, map: "AnnouncementReadStatus_userId_fkey")

  @@unique([userId, announcementId], map: "AnnouncementReadStatus_userId_announcementId_key")
  @@index([announcementId], map: "AnnouncementReadStatus_announcementId_fkey")
  @@index([organizationId, userId, readAt], map: "AnnouncementReadStatus_organizationId_userId_readAt_idx")
  @@map("AnnouncementReadStatus")
}

model AppraisalCycle {
  id             String                @id @default(cuid())
  organizationId String
  title          String
  periodStart    DateTime
  periodEnd      DateTime
  status         appraisalcycle_status @default(DRAFT)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId, status], map: "AppraisalCycle_organizationId_status_idx")
  @@map("AppraisalCycle")
}

model Attendance {
  id             String            @id @default(cuid())
  organizationId String
  employeeId     String
  clockInAt      DateTime
  clockOutAt     DateTime?
  source         attendance_source @default(WEB)
  note           String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "Attendance_employeeId_fkey")

  @@index([employeeId], map: "Attendance_employeeId_fkey")
  @@index([organizationId, employeeId, clockInAt], map: "Attendance_organizationId_employeeId_clockInAt_idx")
  @@map("Attendance")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  resource       String
  resourceId     String?
  summary        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  previousHash   String?      @db.Char(64)
  hash           String?      @db.Char(64)
  sequence       Int?
  actorUser      User?        @relation(fields: [actorUserId], references: [id], map: "AuditLog_actorUserId_fkey")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AuditLog_organizationId_fkey")

  @@unique([organizationId, sequence], map: "AuditLog_organizationId_sequence_key")
  @@index([actorUserId], map: "AuditLog_actorUserId_fkey")
  @@index([organizationId, createdAt], map: "AuditLog_organizationId_createdAt_idx")
  @@index([organizationId, hash], map: "AuditLog_organizationId_hash_idx")
  @@index([organizationId, resource, createdAt], map: "AuditLog_organizationId_resource_createdAt_idx")
  @@map("AuditLog")
}

model AuditLogChain {
  organizationId String       @id
  lastHash       String?      @db.Char(64)
  sequence       Int          @default(0)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AuditLogChain_organizationId_fkey")

  @@map("AuditLogChain")
}

model AuthChallenge {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  purpose        String
  method         String
  codeHash       String
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AuthChallenge_organizationId_fkey")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "AuthChallenge_userId_fkey")

  @@index([organizationId, expiresAt], map: "AuthChallenge_organizationId_expiresAt_idx")
  @@index([organizationId, userId, purpose, createdAt], map: "AuthChallenge_organizationId_userId_purpose_createdAt_idx")
  @@index([userId], map: "AuthChallenge_userId_fkey")
  @@map("AuthChallenge")
}

model AuthEvent {
  id              String       @id @default(cuid())
  organizationId  String
  userId          String?
  emailAttempted  String?
  eventType       String
  status          String
  reasonCode      String?
  ipAddress       String?
  userAgent       String?      @db.Text
  deviceName      String?
  locationState   String?
  locationCountry String?
  occurredAt      DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AuthEvent_organizationId_fkey")
  user            User?        @relation(fields: [userId], references: [id], map: "AuthEvent_userId_fkey")

  @@index([organizationId, occurredAt], map: "AuthEvent_organizationId_occurredAt_idx")
  @@index([organizationId, status, occurredAt], map: "AuthEvent_organizationId_status_occurredAt_idx")
  @@index([organizationId, userId, occurredAt], map: "AuthEvent_organizationId_userId_occurredAt_idx")
  @@index([userId], map: "AuthEvent_userId_fkey")
  @@map("AuthEvent")
}

model BillingFeature {
  id                 String               @id @default(cuid())
  key                String               @unique(map: "BillingFeature_key_key")
  name               String
  normalizedName     String
  description        String?              @db.Text
  moduleKey          String?
  status             String               @default("ACTIVE")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  billingplanfeature BillingPlanFeature[]

  @@unique([moduleKey, normalizedName], map: "BillingFeature_moduleKey_normalizedName_key")
  @@index([moduleKey, status], map: "BillingFeature_moduleKey_status_idx")
  @@map("BillingFeature")
}

model BillingHistory {
  id             String       @id @default(cuid())
  organizationId String
  description    String
  amount         Decimal      @db.Decimal(14, 2)
  currency       String       @default("NGN")
  status         String
  billedAt       DateTime
  providerRef    String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "BillingHistory_organizationId_fkey")

  @@index([organizationId, billedAt], map: "BillingHistory_organizationId_billedAt_idx")
  @@index([organizationId, status, billedAt], map: "BillingHistory_organizationId_status_billedAt_idx")
  @@index([status, billedAt], map: "BillingHistory_status_billedAt_idx")
  @@map("BillingHistory")
}

model BillingNotification {
  id             String       @id @default(cuid())
  organizationId String
  type           String
  renewalDate    DateTime
  scheduledFor   DateTime
  channels       Json
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  errorMessage   String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "BillingNotification_organizationId_fkey")

  @@unique([organizationId, type, renewalDate], map: "BillingNotification_organizationId_type_renewalDate_key")
  @@index([status, scheduledFor], map: "BillingNotification_status_scheduledFor_idx")
  @@map("BillingNotification")
}

model BillingPlanFeature {
  planId    String
  featureId String
  createdAt DateTime           @default(now())
  feature   BillingFeature     @relation(fields: [featureId], references: [id], map: "BillingPlanFeature_featureId_fkey")
  plan      BillingProductPlan @relation(fields: [planId], references: [id], onDelete: Cascade, map: "BillingPlanFeature_planId_fkey")

  @@id([planId, featureId])
  @@index([featureId], map: "BillingPlanFeature_featureId_idx")
  @@map("BillingPlanFeature")
}

model BillingPlanModule {
  planId    String
  moduleKey String
  createdAt DateTime           @default(now())
  plan      BillingProductPlan @relation(fields: [planId], references: [id], onDelete: Cascade, map: "BillingPlanModule_planId_fkey")

  @@id([planId, moduleKey])
  @@index([moduleKey], map: "BillingPlanModule_moduleKey_idx")
  @@map("BillingPlanModule")
}

model BillingPriceVersion {
  id              String                       @id @default(cuid())
  planId          String
  monthlyPrice    Decimal                      @db.Decimal(14, 2)
  currency        String                       @default("NGN")
  effectiveAt     DateTime
  endsAt          DateTime?
  reason          String?                      @db.Text
  changedByUserId String?
  version         Int
  createdAt       DateTime                     @default(now())
  plan            BillingProductPlan           @relation(fields: [planId], references: [id], onDelete: Cascade, map: "BillingPriceVersion_planId_fkey")
  priceAgreements SubscriptionPriceAgreement[]

  @@unique([planId, version], map: "BillingPriceVersion_planId_version_key")
  @@index([effectiveAt, endsAt], map: "BillingPriceVersion_effectiveAt_endsAt_idx")
  @@index([planId, effectiveAt], map: "BillingPriceVersion_planId_effectiveAt_idx")
  @@map("BillingPriceVersion")
}

model BillingProductPlan {
  id              String                       @id @default(cuid())
  key             String                       @unique(map: "BillingProductPlan_key_key")
  name            String
  normalizedName  String                       @unique(map: "BillingProductPlan_normalizedName_key")
  description     String                       @db.Text
  status          String                       @default("ACTIVE")
  pricingModel    String                       @default("FLAT_MONTHLY")
  isSystem        Boolean                      @default(false)
  rowVersion      Int                          @default(1)
  createdByUserId String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  features        BillingPlanFeature[]
  modules         BillingPlanModule[]
  prices          BillingPriceVersion[]
  priceAgreements SubscriptionPriceAgreement[]

  @@index([status, updatedAt], map: "BillingProductPlan_status_updatedAt_idx")
  @@map("BillingProductPlan")
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String       @db.Text
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Branch_organizationId_fkey")

  @@unique([organizationId, name], map: "Branch_organizationId_name_key")
  @@index([organizationId], map: "Branch_organizationId_idx")
  @@map("Branch")
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?      @db.Text
  taxId          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Client_organizationId_fkey")
  invoice        Invoice[]

  @@index([organizationId], map: "Client_organizationId_idx")
  @@map("Client")
}

model ConductLog {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  category       String
  summary        String
  details        String?  @db.Text
  incidentDate   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "ConductLog_employeeId_fkey")

  @@index([employeeId], map: "ConductLog_employeeId_fkey")
  @@index([organizationId, employeeId], map: "ConductLog_organizationId_employeeId_idx")
  @@map("ConductLog")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  headEmployeeId String?
  headEmployee   Employee?    @relation("department_headEmployeeIdToemployee", fields: [headEmployeeId], references: [id], map: "Department_headEmployeeId_fkey")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Department_organizationId_fkey")
  employees      Employee[]   @relation("employee_departmentIdTodepartment")
  team           Team[]

  @@unique([organizationId, name], map: "Department_organizationId_name_key")
  @@index([headEmployeeId], map: "Department_headEmployeeId_idx")
  @@index([organizationId], map: "Department_organizationId_idx")
  @@map("Department")
}

model Employee {
  id                String            @id @default(cuid())
  organizationId    String
  departmentId      String?
  teamId            String?
  employeeNo        String
  firstName         String
  lastName          String
  email             String
  phone             String?
  jobTitle          String?
  hireDate          DateTime?
  status            employee_status   @default(ACTIVE)
  baseSalary        Decimal?          @db.Decimal(14, 2)
  bankName          String?
  bankAccountNumber String?
  pensionPin        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  attendance        Attendance[]
  conductlog        ConductLog[]
  headedDepartments Department[]      @relation("department_headEmployeeIdToemployee")
  department        Department?       @relation("employee_departmentIdTodepartment", fields: [departmentId], references: [id], map: "Employee_departmentId_fkey")
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Employee_organizationId_fkey")
  team              Team?             @relation(fields: [teamId], references: [id], map: "Employee_teamId_fkey")
  leaverequest      LeaveRequest[]
  loans             LoanAdvance[]
  payslip           Payslip[]
  salaryStructures  SalaryStructure[]
  user              User?

  @@unique([organizationId, email], map: "Employee_organizationId_email_key")
  @@unique([organizationId, employeeNo], map: "Employee_organizationId_employeeNo_key")
  @@index([departmentId], map: "Employee_departmentId_fkey")
  @@index([organizationId], map: "Employee_organizationId_idx")
  @@index([teamId], map: "Employee_teamId_fkey")
  @@map("Employee")
}

model Invoice {
  id             String         @id @default(cuid())
  organizationId String
  clientId       String
  invoiceNo      String
  issueDate      DateTime
  dueDate        DateTime?
  status         invoice_status @default(DRAFT)
  subtotal       Decimal        @db.Decimal(14, 2)
  taxAmount      Decimal        @default(0.00) @db.Decimal(14, 2)
  total          Decimal        @db.Decimal(14, 2)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  client         Client         @relation(fields: [clientId], references: [id], map: "Invoice_clientId_fkey")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Invoice_organizationId_fkey")
  items          InvoiceItem[]

  @@unique([organizationId, invoiceNo], map: "Invoice_organizationId_invoiceNo_key")
  @@index([clientId], map: "Invoice_clientId_fkey")
  @@index([organizationId, status], map: "Invoice_organizationId_status_idx")
  @@map("Invoice")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, map: "InvoiceItem_invoiceId_fkey")

  @@index([invoiceId], map: "InvoiceItem_invoiceId_fkey")
  @@map("InvoiceItem")
}

model IpAllowlistEntry {
  id              String       @id @default(cuid())
  organizationId  String
  value           String
  label           String?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  user            User?        @relation(fields: [createdByUserId], references: [id], map: "IpAllowlistEntry_createdByUserId_fkey")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "IpAllowlistEntry_organizationId_fkey")

  @@unique([organizationId, value], map: "IpAllowlistEntry_organizationId_value_key")
  @@index([createdByUserId], map: "IpAllowlistEntry_createdByUserId_fkey")
  @@index([organizationId, createdAt], map: "IpAllowlistEntry_organizationId_createdAt_idx")
  @@map("IpAllowlistEntry")
}

model LeaveRequest {
  id             String              @id @default(cuid())
  organizationId String
  employeeId     String
  type           String
  startDate      DateTime
  endDate        DateTime
  reason         String?             @db.Text
  status         leaverequest_status @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  employee       Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "LeaveRequest_employeeId_fkey")

  @@index([employeeId], map: "LeaveRequest_employeeId_fkey")
  @@index([organizationId, employeeId, status], map: "LeaveRequest_organizationId_employeeId_status_idx")
  @@map("LeaveRequest")
}

model LoanAdvance {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  amount         Decimal  @db.Decimal(14, 2)
  outstanding    Decimal  @db.Decimal(14, 2)
  reason         String?  @db.Text
  issuedAt       DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "LoanAdvance_employeeId_fkey")

  @@index([employeeId], map: "LoanAdvance_employeeId_fkey")
  @@index([organizationId, employeeId], map: "LoanAdvance_organizationId_employeeId_idx")
  @@map("LoanAdvance")
}

model NotificationCategory {
  id                           String                         @id @default(cuid())
  moduleKey                    String
  moduleName                   String
  key                          String
  name                         String
  description                  String                         @db.Text
  isActive                     Boolean                        @default(true)
  sortOrder                    Int                            @default(0)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  tenantnotificationpreference TenantNotificationPreference[]

  @@unique([moduleKey, key], map: "NotificationCategory_moduleKey_key_key")
  @@index([moduleKey, isActive, sortOrder], map: "NotificationCategory_moduleKey_isActive_sortOrder_idx")
  @@map("NotificationCategory")
}

model NotificationChannel {
  id                           String                         @id @default(cuid())
  key                          String                         @unique(map: "NotificationChannel_key_key")
  name                         String
  description                  String?
  isActive                     Boolean                        @default(true)
  sortOrder                    Int                            @default(0)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  tenantnotificationpreference TenantNotificationPreference[]

  @@index([isActive, sortOrder], map: "NotificationChannel_isActive_sortOrder_idx")
  @@map("NotificationChannel")
}

model Organization {
  id                           String                         @id @default(cuid())
  name                         String
  slug                         String                         @unique(map: "Organization_slug_key")
  email                        String?
  phone                        String?
  address                      String?                        @db.Text
  country                      String?
  currency                     String                         @default("NGN")
  taxId                        String?
  status                       organization_status            @default(ACTIVE)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  profileImageUrl              String?
  industry                     String?
  cacNumber                    String?
  registrationAddress          String?                        @db.Text
  website                      String?
  fiscalYearStart              String?
  companySize                  String?
  suspendedAt                  DateTime?
  suspensionReason             String?                        @db.Text
  suspendedByUserId            String?
  agentinvitation              AgentInvitation[]
  announcementReadStatuses     AnnouncementReadStatus[]
  auditLogs                    AuditLog[]
  auditlogchain                AuditLogChain?
  authchallenge                AuthChallenge[]
  authevent                    AuthEvent[]
  billinghistory               BillingHistory[]
  billingnotification          BillingNotification[]
  branches                     Branch[]
  client                       Client[]
  departments                  Department[]
  employees                    Employee[]
  invoice                      Invoice[]
  ipallowlistentry             IpAllowlistEntry[]
  organizationdataexport       OrganizationDataExport[]
  deletionRequests             OrganizationDeletionRequest[]
  generalSettings              OrganizationGeneralSettings?
  paymentcard                  PaymentCard[]
  paymentrequest               PaymentRequest[]
  payrollrun                   PayrollRun[]
  platformimpersonationsession PlatformImpersonationSession[]
  role                         Role[]
  salarystructure              SalaryStructure[]
  securitypolicy               SecurityPolicy?
  subscriptionplanchange       SubscriptionPlanChange[]
  subscriptionpriceagreement   SubscriptionPriceAgreement[]
  supportticket                SupportTicket[]
  systemalert                  SystemAlert[]
  systemconfig                 SystemConfig[]
  taxreport                    TaxReport[]
  team                         Team[]
  tenantnotificationpreference TenantNotificationPreference[]
  users                        User[]
  usersession                  UserSession[]
  walletaccount                WalletAccount[]
  workschedule                 WorkSchedule?

  @@index([status, createdAt], map: "Organization_status_createdAt_idx")
  @@map("Organization")
}

model OrganizationDataExport {
  id                String       @id @default(cuid())
  organizationId    String
  requestedByUserId String
  status            String       @default("PENDING_PLATFORM_FULFILLMENT")
  fileName          String?
  fileReference     String?
  fileSize          Int?
  requestedAt       DateTime     @default(now())
  completedAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deliveryEmail     String
  deliveryDueAt     DateTime
  deliveredAt       DateTime?
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "OrgDataExport_org_fkey")

  @@index([status, deliveryDueAt], map: "OrgDataExport_delivery_due_idx")
  @@index([organizationId, requestedAt], map: "OrgDataExport_org_requested_idx")
  @@index([status, requestedAt], map: "OrgDataExport_status_requested_idx")
  @@map("OrganizationDataExport")
}

model OrganizationDeletionRequest {
  id                String       @id @default(cuid())
  organizationId    String
  requestedByUserId String
  status            String       @default("PENDING_PLATFORM_APPROVAL")
  reason            String?      @db.Text
  requestedAt       DateTime     @default(now())
  reviewedAt        DateTime?
  reviewedByUserId  String?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "OrgDeletionRequest_org_fkey")

  @@index([organizationId, status], map: "OrgDeletionRequest_org_status_idx")
  @@index([status, requestedAt], map: "OrgDeletionRequest_status_requested_idx")
  @@map("OrganizationDeletionRequest")
}

model OrganizationGeneralSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique(map: "OrgGeneralSettings_org_key")
  timeZone       String       @default("Africa/Lagos")
  language       String       @default("en")
  dateFormat     String       @default("DD/MM/YYYY")
  currency       String       @default("NGN")
  accentColor    String       @default("#2563EB")
  linkText       String?
  logoUrl        String?
  logoFileName   String?
  logoMimeType   String?
  logoSize       Int?
  logoWidth      Int?
  logoHeight     Int?
  logoUploadedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "OrgGeneralSettings_org_fkey")

  @@map("OrganizationGeneralSettings")
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PasswordResetOtp_userId_fkey")

  @@index([expiresAt], map: "PasswordResetOtp_expiresAt_idx")
  @@index([userId, createdAt], map: "PasswordResetOtp_userId_createdAt_idx")
  @@map("PasswordResetOtp")
}

model PaymentCard {
  id                String       @id @default(cuid())
  organizationId    String
  cardHolderName    String
  brand             String
  last4             String
  expMonth          Int
  expYear           Int
  provider          String?
  providerCardToken String?
  isDefault         Boolean      @default(false)
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "PaymentCard_organizationId_fkey")

  @@index([organizationId, createdAt], map: "PaymentCard_organizationId_createdAt_idx")
  @@index([organizationId, isDefault], map: "PaymentCard_organizationId_isDefault_idx")
  @@map("PaymentCard")
}

model PaymentRequest {
  id             String                @id @default(cuid())
  organizationId String
  title          String
  vendorName     String?
  amount         Decimal               @db.Decimal(14, 2)
  currency       String                @default("NGN")
  status         paymentrequest_status @default(PENDING)
  requestedBy    String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "PaymentRequest_organizationId_fkey")

  @@index([organizationId, status], map: "PaymentRequest_organizationId_status_idx")
  @@map("PaymentRequest")
}

model PayrollRun {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  periodStart    DateTime
  periodEnd      DateTime
  payDate        DateTime?
  status         payrollrun_status @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "PayrollRun_organizationId_fkey")
  payslip        Payslip[]

  @@index([organizationId, status], map: "PayrollRun_organizationId_status_idx")
  @@map("PayrollRun")
}

model Payslip {
  id             String     @id @default(cuid())
  organizationId String
  payrollRunId   String
  employeeId     String
  grossPay       Decimal    @db.Decimal(14, 2)
  payeTax        Decimal    @default(0.00) @db.Decimal(14, 2)
  pension        Decimal    @default(0.00) @db.Decimal(14, 2)
  deductions     Decimal    @default(0.00) @db.Decimal(14, 2)
  netPay         Decimal    @db.Decimal(14, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  employee       Employee   @relation(fields: [employeeId], references: [id], map: "Payslip_employeeId_fkey")
  payrollrun     PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade, map: "Payslip_payrollRunId_fkey")

  @@unique([payrollRunId, employeeId], map: "Payslip_payrollRunId_employeeId_key")
  @@index([employeeId], map: "Payslip_employeeId_fkey")
  @@index([organizationId, employeeId], map: "Payslip_organizationId_employeeId_idx")
  @@map("Payslip")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique(map: "Permission_key_key")
  description     String?
  rolePermissions RolePermission[]

  @@map("Permission")
}

model PlatformAnnouncement {
  id               String                   @id @default(cuid())
  title            String
  summary          String                   @db.Text
  description      String                   @db.LongText
  type             String
  contentFormat    String                   @default("MARKDOWN")
  learnMoreUrl     String?
  contentReference String?
  publishedAt      DateTime?
  expiresAt        DateTime?
  isPublished      Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  readStatuses     AnnouncementReadStatus[]

  @@index([isPublished, publishedAt], map: "PlatformAnnouncement_isPublished_publishedAt_idx")
  @@index([type, publishedAt], map: "PlatformAnnouncement_type_publishedAt_idx")
  @@map("PlatformAnnouncement")
}

model PlatformImpersonationSession {
  id                  String       @id @default(cuid())
  organizationId      String
  platformAdminUserId String
  tenantAdminUserId   String
  status              String       @default("ACTIVE")
  startedAt           DateTime     @default(now())
  expiresAt           DateTime
  endedAt             DateTime?
  ipAddress           String?
  userAgent           String?      @db.Text
  platformAdmin       User         @relation("platformimpersonationsession_platformAdminUserIdTouser", fields: [platformAdminUserId], references: [id], onDelete: Cascade, map: "Impersonation_actor_fkey")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Impersonation_org_fkey")
  tenantAdmin         User         @relation("platformimpersonationsession_tenantAdminUserIdTouser", fields: [tenantAdminUserId], references: [id], onDelete: Cascade, map: "Impersonation_target_fkey")

  @@index([platformAdminUserId, status, expiresAt], map: "Impersonation_admin_status_expiry_idx")
  @@index([organizationId, startedAt], map: "Impersonation_org_started_idx")
  @@index([tenantAdminUserId], map: "Impersonation_target_fkey")
  @@map("PlatformImpersonationSession")
}

model Role {
  id              String            @id @default(cuid())
  organizationId  String
  name            String
  description     String?           @db.Text
  isSystem        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  agentinvitation AgentInvitation[]
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Role_organizationId_fkey")
  permissions     RolePermission[]
  user            User[]

  @@unique([organizationId, name], map: "Role_organizationId_name_key")
  @@index([organizationId], map: "Role_organizationId_idx")
  @@map("Role")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "RolePermission_permissionId_fkey")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "RolePermission_roleId_fkey")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
  @@map("RolePermission")
}

model SalaryStructure {
  id             String       @id @default(cuid())
  organizationId String
  employeeId     String
  title          String
  basic          Decimal      @db.Decimal(14, 2)
  housing        Decimal      @default(0.00) @db.Decimal(14, 2)
  transport      Decimal      @default(0.00) @db.Decimal(14, 2)
  otherAllowance Decimal      @default(0.00) @db.Decimal(14, 2)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "SalaryStructure_employeeId_fkey")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "SalaryStructure_organizationId_fkey")

  @@index([employeeId], map: "SalaryStructure_employeeId_fkey")
  @@index([organizationId, employeeId], map: "SalaryStructure_organizationId_employeeId_idx")
  @@map("SalaryStructure")
}

model SecurityPolicy {
  id                          String       @id @default(cuid())
  organizationId              String       @unique(map: "SecurityPolicy_organizationId_key")
  minPasswordLength           Int          @default(8)
  passwordExpiryDays          Int          @default(90)
  lockoutMaxAttempts          Int          @default(5)
  requireUppercase            Boolean      @default(true)
  requireLowercase            Boolean      @default(true)
  requireNumber               Boolean      @default(true)
  requireSpecialCharacter     Boolean      @default(true)
  twoFactorEnabled            Boolean      @default(false)
  enforceTwoFactorForAllUsers Boolean      @default(false)
  allowAuthenticatorApp       Boolean      @default(true)
  allowSmsOtp                 Boolean      @default(false)
  allowEmailOtp               Boolean      @default(true)
  ipAllowlistEnabled          Boolean      @default(false)
  updatedByUserId             String?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "SecurityPolicy_organizationId_fkey")
  user                        User?        @relation(fields: [updatedByUserId], references: [id], map: "SecurityPolicy_updatedByUserId_fkey")

  @@index([organizationId, updatedAt], map: "SecurityPolicy_organizationId_updatedAt_idx")
  @@index([updatedByUserId], map: "SecurityPolicy_updatedByUserId_fkey")
  @@map("SecurityPolicy")
}

model SubscriptionPlanChange {
  id                  String       @id @default(cuid())
  organizationId      String
  fromPlanKey         String
  toPlanKey           String
  billingCycle        String
  currentMonthlyCost  Decimal      @db.Decimal(14, 2)
  selectedMonthlyCost Decimal      @db.Decimal(14, 2)
  billingImpact       Decimal      @db.Decimal(14, 2)
  proratedCharge      Decimal      @default(0.00) @db.Decimal(14, 2)
  currency            String       @default("NGN")
  effectiveAt         DateTime
  status              String       @default("PENDING")
  paymentReference    String?
  automaticRenewal    Boolean      @default(true)
  confirmedByUserId   String?
  confirmedAt         DateTime?
  appliedAt           DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "SubscriptionPlanChange_organizationId_fkey")

  @@index([organizationId, status, effectiveAt], map: "SubscriptionPlanChange_organizationId_status_effectiveAt_idx")
  @@index([status, effectiveAt], map: "SubscriptionPlanChange_status_effectiveAt_idx")
  @@map("SubscriptionPlanChange")
}

model SubscriptionPriceAgreement {
  id             String               @id @default(cuid())
  organizationId String
  planId         String
  priceVersionId String?
  source         String               @default("BASE_PLAN")
  monthlyPrice   Decimal              @db.Decimal(14, 2)
  currency       String               @default("NGN")
  startsAt       DateTime
  endsAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "SubscriptionPriceAgreement_organizationId_fkey")
  plan           BillingProductPlan   @relation(fields: [planId], references: [id], map: "SubscriptionPriceAgreement_planId_fkey")
  priceVersion   BillingPriceVersion? @relation(fields: [priceVersionId], references: [id], map: "SubscriptionPriceAgreement_priceVersionId_fkey")

  @@unique([organizationId, planId, source, startsAt], map: "SubPriceAgreement_org_plan_source_start_key")
  @@index([organizationId, startsAt, endsAt], map: "SubPriceAgreement_org_start_end_idx")
  @@index([planId, startsAt, endsAt], map: "SubPriceAgreement_plan_start_end_idx")
  @@index([priceVersionId], map: "SubscriptionPriceAgreement_priceVersionId_fkey")
  @@map("SubscriptionPriceAgreement")
}

model SupportTicket {
  id               String       @id @default(cuid())
  organizationId   String
  ticketNumber     String       @unique(map: "SupportTicket_ticketNumber_key")
  subject          String
  description      String?      @db.Text
  priority         String
  status           String
  assignedToUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  assignedTo       User?        @relation(fields: [assignedToUserId], references: [id], map: "SupportTicket_assignee_fkey")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "SupportTicket_org_fkey")

  @@index([assignedToUserId], map: "SupportTicket_assignee_fkey")
  @@index([organizationId, status, priority], map: "SupportTicket_org_status_priority_idx")
  @@index([organizationId, updatedAt], map: "SupportTicket_org_updated_idx")
  @@map("SupportTicket")
}

model SystemAlert {
  id                   String               @id @default(cuid())
  organizationId       String
  key                  String
  title                String
  message              String
  severity             systemalert_severity @default(INFO)
  status               systemalert_status   @default(OPEN)
  isActive             Boolean              @default(true)
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  resolvedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User?                @relation(fields: [acknowledgedByUserId], references: [id], map: "SystemAlert_acknowledgedByUserId_fkey")
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "SystemAlert_organizationId_fkey")

  @@unique([organizationId, key], map: "SystemAlert_organizationId_key_key")
  @@index([acknowledgedByUserId], map: "SystemAlert_acknowledgedByUserId_fkey")
  @@index([organizationId, isActive, severity], map: "SystemAlert_organizationId_isActive_severity_idx")
  @@index([organizationId, status, updatedAt], map: "SystemAlert_organizationId_status_updatedAt_idx")
  @@map("SystemAlert")
}

model SystemConfig {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  value          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "SystemConfig_organizationId_fkey")

  @@unique([organizationId, key], map: "SystemConfig_organizationId_key_key")
  @@index([key], map: "SystemConfig_key_idx")
  @@map("SystemConfig")
}

model TaxReport {
  id             String       @id @default(cuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  type           String
  amount         Decimal      @db.Decimal(14, 2)
  submittedAt    DateTime?
  reference      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "TaxReport_organizationId_fkey")

  @@index([organizationId, type], map: "TaxReport_organizationId_type_idx")
  @@map("TaxReport")
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  description    String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employees      Employee[]
  department     Department?  @relation(fields: [departmentId], references: [id], map: "Team_departmentId_fkey")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Team_organizationId_fkey")

  @@unique([organizationId, name], map: "Team_organizationId_name_key")
  @@index([departmentId], map: "Team_departmentId_fkey")
  @@index([organizationId], map: "Team_organizationId_idx")
  @@map("Team")
}

model TenantNotificationPreference {
  id                   String               @id @default(cuid())
  organizationId       String
  channelId            String
  categoryId           String
  enabled              Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  notificationcategory NotificationCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "TenantNotificationPreference_categoryId_fkey")
  notificationchannel  NotificationChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade, map: "TenantNotificationPreference_channelId_fkey")
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "TenantNotificationPreference_organizationId_fkey")

  @@unique([organizationId, channelId, categoryId], map: "TenantPref_org_channel_category_uq")
  @@index([categoryId], map: "TenantNotificationPreference_categoryId_fkey")
  @@index([channelId], map: "TenantNotificationPreference_channelId_fkey")
  @@index([organizationId, channelId], map: "TenantPref_org_channel_idx")
  @@map("TenantNotificationPreference")
}

model User {
  id                                                                                  String                         @id @default(cuid())
  organizationId                                                                      String
  roleId                                                                              String
  employeeId                                                                          String?                        @unique(map: "User_employeeId_key")
  email                                                                               String
  passwordHash                                                                        String
  firstName                                                                           String
  lastName                                                                            String
  isActive                                                                            Boolean                        @default(true)
  lastLoginAt                                                                         DateTime?
  createdAt                                                                           DateTime                       @default(now())
  updatedAt                                                                           DateTime                       @updatedAt
  profileImageUrl                                                                     String?
  failedLoginAttempts                                                                 Int                            @default(0)
  lockedUntil                                                                         DateTime?
  passwordChangedAt                                                                   DateTime                       @default(now())
  isPlatformAdmin                                                                     Boolean                        @default(false)
  agentinvitation                                                                     AgentInvitation[]
  announcementreadstatus                                                              AnnouncementReadStatus[]
  auditlog                                                                            AuditLog[]
  authchallenge                                                                       AuthChallenge[]
  authevent                                                                           AuthEvent[]
  ipallowlistentry                                                                    IpAllowlistEntry[]
  passwordresetotp                                                                    PasswordResetOtp[]
  platformimpersonationsession_platformimpersonationsession_platformAdminUserIdTouser PlatformImpersonationSession[] @relation("platformimpersonationsession_platformAdminUserIdTouser")
  platformimpersonationsession_platformimpersonationsession_tenantAdminUserIdTouser   PlatformImpersonationSession[] @relation("platformimpersonationsession_tenantAdminUserIdTouser")
  securitypolicy                                                                      SecurityPolicy[]
  supportticket                                                                       SupportTicket[]
  systemalert                                                                         SystemAlert[]
  employee                                                                            Employee?                      @relation(fields: [employeeId], references: [id], map: "User_employeeId_fkey")
  organization                                                                        Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "User_organizationId_fkey")
  role                                                                                Role                           @relation(fields: [roleId], references: [id], map: "User_roleId_fkey")
  usersession                                                                         UserSession[]
  twoFactor                                                                           UserTwoFactor?

  @@unique([organizationId, email], map: "User_organizationId_email_key")
  @@index([isPlatformAdmin, isActive], map: "User_isPlatformAdmin_isActive_idx")
  @@index([organizationId], map: "User_organizationId_idx")
  @@index([roleId], map: "User_roleId_fkey")
  @@map("User")
}

model UserSession {
  id               String       @id @default(cuid())
  organizationId   String
  userId           String
  refreshTokenHash String
  deviceName       String?
  userAgent        String?      @db.Text
  ipAddress        String?
  locationState    String?
  locationCountry  String?
  isCurrent        Boolean      @default(false)
  revokedAt        DateTime?
  revokeReason     String?
  lastSeenAt       DateTime     @default(now())
  expiresAt        DateTime
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "UserSession_organizationId_fkey")
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserSession_userId_fkey")

  @@index([organizationId, createdAt], map: "UserSession_organizationId_createdAt_idx")
  @@index([organizationId, revokedAt], map: "UserSession_organizationId_revokedAt_idx")
  @@index([organizationId, userId, revokedAt], map: "UserSession_organizationId_userId_revokedAt_idx")
  @@index([userId], map: "UserSession_userId_fkey")
  @@map("UserSession")
}

model UserTwoFactor {
  id                     String   @id @default(cuid())
  userId                 String   @unique(map: "UserTwoFactor_userId_key")
  authenticatorSecretEnc String?
  authenticatorEnabled   Boolean  @default(false)
  phoneNumber            String?
  preferredMethod        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserTwoFactor_userId_fkey")

  @@index([authenticatorEnabled, updatedAt], map: "UserTwoFactor_authenticatorEnabled_updatedAt_idx")
  @@map("UserTwoFactor")
}

model WalletAccount {
  id                 String               @id @default(cuid())
  organizationId     String
  name               String
  balance            Decimal              @default(0.00) @db.Decimal(14, 2)
  currency           String               @default("NGN")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "WalletAccount_organizationId_fkey")
  walletdisbursement WalletDisbursement[]

  @@index([organizationId], map: "WalletAccount_organizationId_idx")
  @@map("WalletAccount")
}

model WalletDisbursement {
  id              String                    @id @default(cuid())
  walletAccountId String
  organizationId  String
  beneficiaryName String
  amount          Decimal                   @db.Decimal(14, 2)
  status          walletdisbursement_status @default(PENDING)
  reference       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  walletaccount   WalletAccount             @relation(fields: [walletAccountId], references: [id], onDelete: Cascade, map: "WalletDisbursement_walletAccountId_fkey")

  @@index([organizationId, status], map: "WalletDisbursement_organizationId_status_idx")
  @@index([walletAccountId], map: "WalletDisbursement_walletAccountId_fkey")
  @@map("WalletDisbursement")
}

model WorkSchedule {
  id                   String       @id @default(cuid())
  organizationId       String       @unique(map: "WorkSchedule_organizationId_key")
  monday               Boolean      @default(true)
  tuesday              Boolean      @default(true)
  wednesday            Boolean      @default(true)
  thursday             Boolean      @default(true)
  friday               Boolean      @default(true)
  saturday             Boolean      @default(false)
  sunday               Boolean      @default(false)
  workStartTime        String       @default("09:00")
  workEndTime          String       @default("17:00")
  breakDurationMinutes Int          @default(60)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "WorkSchedule_organizationId_fkey")

  @@index([organizationId], map: "WorkSchedule_organizationId_idx")
  @@map("WorkSchedule")
}

enum agentinvitation_status {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum appraisalcycle_status {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum attendance_source {
  WEB
  MOBILE
  ADMIN
}

enum systemalert_severity {
  INFO
  WARNING
  CRITICAL
}

enum walletdisbursement_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum invoice_status {
  DRAFT
  SENT
  PAID
  VOID
  OVERDUE
}

enum paymentrequest_status {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum payrollrun_status {
  DRAFT
  PROCESSING
  APPROVED
  PAID
  CANCELLED
}

enum systemalert_status {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum leaverequest_status {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum organization_status {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum employee_status {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}
