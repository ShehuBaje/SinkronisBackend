generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AgentInvitation {
  id              String                 @id @default(cuid())
  organizationId  String
  email           String
  token           String                 @unique(map: "AgentInvitation_token_key")
  status          agentinvitation_status @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  roleId          String?
  invitedByUserId String?
  moduleAccess    Json?
  user            User?                  @relation(fields: [invitedByUserId], references: [id], map: "AgentInvitation_invitedByUserId_fkey")
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AgentInvitation_organizationId_fkey")
  role            Role?                  @relation(fields: [roleId], references: [id], map: "AgentInvitation_roleId_fkey")

  @@index([invitedByUserId], map: "AgentInvitation_invitedByUserId_fkey")
  @@index([organizationId, roleId], map: "AgentInvitation_organizationId_roleId_idx")
  @@index([organizationId, status], map: "AgentInvitation_organizationId_status_idx")
  @@index([roleId], map: "AgentInvitation_roleId_fkey")
  @@map("AgentInvitation")
}

model AnnouncementReadStatus {
  id                   String               @id @default(cuid())
  organizationId       String
  userId               String
  announcementId       String
  readAt               DateTime             @default(now())
  createdAt            DateTime             @default(now())
  platformannouncement PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade, map: "AnnouncementReadStatus_announcementId_fkey")
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AnnouncementReadStatus_organizationId_fkey")
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade, map: "AnnouncementReadStatus_userId_fkey")

  @@unique([userId, announcementId], map: "AnnouncementReadStatus_userId_announcementId_key")
  @@index([announcementId], map: "AnnouncementReadStatus_announcementId_fkey")
  @@index([organizationId, userId, readAt], map: "AnnouncementReadStatus_organizationId_userId_readAt_idx")
  @@map("AnnouncementReadStatus")
}

model AppraisalCycle {
  id               String                @id @default(cuid())
  organizationId   String
  title            String
  description      String?               @db.Text
  periodStart      DateTime
  periodEnd        DateTime
  status           appraisalcycle_status @default(DRAFT)
  quarter          String?
  year             Int?
  deadline         DateTime?
  templateId       String?
  templateSnapshot Json?
  launchedAt       DateTime?
  launchedById     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  template         AppraisalTemplate?    @relation(fields: [templateId], references: [id], map: "AppraisalCycle_templateId_fkey")
  appraisals       EmployeeAppraisal[]

  @@index([organizationId, status], map: "AppraisalCycle_organizationId_status_idx")
  @@index([organizationId, year, quarter], map: "AppraisalCycle_org_year_quarter_idx")
  @@index([templateId], map: "AppraisalCycle_templateId_idx")
  @@map("AppraisalCycle")
}

model AppraisalTemplate {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  description    String?             @db.Text
  configuration  Json
  isDefault      Boolean             @default(false)
  version        Int                 @default(1)
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  cycles         AppraisalCycle[]
  appraisals     EmployeeAppraisal[]

  @@unique([organizationId, name], map: "AppraisalTemplate_org_name_key")
  @@index([organizationId], map: "AppraisalTemplate_org_idx")
  @@index([organizationId, isDefault, archivedAt], map: "AppraisalTemplate_org_default_archived_idx")
  @@map("AppraisalTemplate")
}

model EmployeeAppraisal {
  id                   String                   @id @default(cuid())
  organizationId       String
  employeeId           String
  managerId            String?
  cycleId              String
  templateId           String
  stage                appraisal_workflow_stage @default(GOAL_SETTING)
  status               appraisal_record_status  @default(IN_PROGRESS)
  finalScore           Decimal?                 @db.Decimal(6, 2)
  rating               String?
  ratingValue          Int?
  templateSnapshot     Json?
  acknowledgedResponse String?                  @db.Text
  acknowledgedAt       DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  employee             Employee                 @relation("EmployeeAppraisalEmployee", fields: [employeeId], references: [id], onDelete: Cascade, map: "EmployeeAppraisal_employeeId_fkey")
  manager              Employee?                @relation("EmployeeAppraisalManager", fields: [managerId], references: [id], map: "EmployeeAppraisal_managerId_fkey")
  cycle                AppraisalCycle           @relation(fields: [cycleId], references: [id], onDelete: Cascade, map: "EmployeeAppraisal_cycleId_fkey")
  template             AppraisalTemplate        @relation(fields: [templateId], references: [id], map: "EmployeeAppraisal_templateId_fkey")
  goals                AppraisalGoal[]
  selfAssessment       AppraisalSelfAssessment?
  managerReview        AppraisalManagerReview?
  hrApproval           AppraisalHRApproval?
  signOffs             AppraisalSignOff[]

  @@unique([organizationId, employeeId, cycleId], map: "EmployeeAppraisal_org_employee_cycle_key")
  @@index([organizationId, cycleId, stage], map: "EmployeeAppraisal_org_cycle_stage_idx")
  @@index([organizationId, status], map: "EmployeeAppraisal_org_status_idx")
  @@index([managerId, stage], map: "EmployeeAppraisal_manager_stage_idx")
  @@map("EmployeeAppraisal")
}

model AppraisalSignOff {
  id              String            @id @default(cuid())
  organizationId  String
  appraisalId     String
  signatoryUserId String
  signOffType     String
  signatoryRole   String
  signedAt        DateTime          @default(now())
  appraisal       EmployeeAppraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade, map: "AppraisalSignOff_appraisalId_fkey")
  signatory       User              @relation(fields: [signatoryUserId], references: [id], map: "AppraisalSignOff_signatoryUserId_fkey")

  @@unique([appraisalId, signOffType], map: "AppraisalSignOff_appraisal_type_key")
  @@index([organizationId, signedAt], map: "AppraisalSignOff_org_signed_idx")
  @@index([signatoryUserId], map: "AppraisalSignOff_signatory_idx")
  @@map("AppraisalSignOff")
}

model AppraisalSetting {
  id                     String                 @id @default(cuid())
  organizationId         String                 @unique(map: "AppraisalSetting_organizationId_key")
  defaultReviewFrequency String                 @default("QUARTERLY")
  updatedById            String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AppraisalSetting_organizationId_fkey")
  NotificationCategory   NotificationCategory[]

  @@map("AppraisalSetting")
}

model AppraisalGoal {
  id              String                @id @default(cuid())
  organizationId  String
  appraisalId     String
  title           String
  description     String                @db.Text
  successCriteria String                @db.Text
  targetDate      DateTime
  status          appraisal_goal_status @default(NOT_STARTED)
  employeeRating  Int?
  employeeComment String?               @db.Text
  managerRating   Int?
  managerComment  String?               @db.Text
  createdById     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  appraisal       EmployeeAppraisal     @relation(fields: [appraisalId], references: [id], onDelete: Cascade, map: "AppraisalGoal_appraisalId_fkey")

  @@index([organizationId, appraisalId], map: "AppraisalGoal_org_appraisal_idx")
  @@map("AppraisalGoal")
}

model AppraisalSelfAssessment {
  id             String                      @id @default(cuid())
  organizationId String
  appraisalId    String                      @unique(map: "AppraisalSelfAssessment_appraisalId_key")
  status         appraisal_submission_status @default(IN_PROGRESS)
  sections       Json
  reflections    Json
  submittedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  appraisal      EmployeeAppraisal           @relation(fields: [appraisalId], references: [id], onDelete: Cascade, map: "AppraisalSelfAssessment_appraisalId_fkey")

  @@index([organizationId, status], map: "AppraisalSelfAssessment_org_status_idx")
  @@map("AppraisalSelfAssessment")
}

model AppraisalManagerReview {
  id              String                      @id @default(cuid())
  organizationId  String
  appraisalId     String                      @unique(map: "AppraisalManagerReview_appraisalId_key")
  managerId       String
  status          appraisal_submission_status @default(IN_PROGRESS)
  goalRatings     Json
  responses       Json
  overallFeedback String?                     @db.Text
  recommendation  String?
  submittedAt     DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  appraisal       EmployeeAppraisal           @relation(fields: [appraisalId], references: [id], onDelete: Cascade, map: "AppraisalManagerReview_appraisalId_fkey")

  @@index([organizationId, status], map: "AppraisalManagerReview_org_status_idx")
  @@map("AppraisalManagerReview")
}

model AppraisalHRApproval {
  id             String                @id @default(cuid())
  organizationId String
  appraisalId    String                @unique(map: "AppraisalHRApproval_appraisalId_key")
  decision       appraisal_hr_decision
  internalNotes  String?               @db.Text
  approvedById   String
  approvedAt     DateTime              @default(now())
  appraisal      EmployeeAppraisal     @relation(fields: [appraisalId], references: [id], onDelete: Cascade, map: "AppraisalHRApproval_appraisalId_fkey")

  @@index([organizationId, decision], map: "AppraisalHRApproval_org_decision_idx")
  @@map("AppraisalHRApproval")
}

model Attendance {
  id             String              @id @default(cuid())
  organizationId String
  employeeId     String
  clockInAt      DateTime
  clockOutAt     DateTime?
  source         attendance_source   @default(WEB)
  note           String?             @db.Text
  manualStatus   String?
  taskCompleted  String?             @db.Text
  overriddenAt   DateTime?
  overriddenById String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  employee       Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "Attendance_employeeId_fkey")
  disputes       AttendanceDispute[]

  @@index([employeeId], map: "Attendance_employeeId_fkey")
  @@index([organizationId, clockInAt], map: "Attendance_organizationId_clockInAt_idx")
  @@index([organizationId, employeeId, clockInAt], map: "Attendance_organizationId_employeeId_clockInAt_idx")
  @@map("Attendance")
}

model AttendanceDispute {
  id              String                    @id @default(cuid())
  disputeNo       String                    @unique(map: "AttendanceDispute_disputeNo_key")
  organizationId  String
  attendanceId    String
  employeeId      String
  issueType       attendance_dispute_issue
  description     String                    @db.Text
  claimedClockIn  DateTime?
  claimedClockOut DateTime?
  status          attendance_dispute_status @default(PENDING)
  resolutionNote  String?                   @db.Text
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  attendance      Attendance                @relation(fields: [attendanceId], references: [id], onDelete: Cascade, map: "AttendanceDispute_attendanceId_fkey")
  employee        Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "AttendanceDispute_employeeId_fkey")

  @@index([organizationId, status, createdAt], map: "AttendanceDispute_org_status_created_idx")
  @@index([organizationId, employeeId], map: "AttendanceDispute_org_employee_idx")
  @@index([attendanceId], map: "AttendanceDispute_attendanceId_idx")
  @@map("AttendanceDispute")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  resource       String
  resourceId     String?
  summary        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  previousHash   String?      @db.Char(64)
  hash           String?      @db.Char(64)
  sequence       Int?
  actorUser      User?        @relation(fields: [actorUserId], references: [id], map: "AuditLog_actorUserId_fkey")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AuditLog_organizationId_fkey")

  @@unique([organizationId, sequence], map: "AuditLog_organizationId_sequence_key")
  @@index([actorUserId], map: "AuditLog_actorUserId_fkey")
  @@index([organizationId, createdAt], map: "AuditLog_organizationId_createdAt_idx")
  @@index([organizationId, hash], map: "AuditLog_organizationId_hash_idx")
  @@index([organizationId, resource, createdAt], map: "AuditLog_organizationId_resource_createdAt_idx")
  @@map("AuditLog")
}

model AuditLogChain {
  organizationId String       @id
  lastHash       String?      @db.Char(64)
  sequence       Int          @default(0)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AuditLogChain_organizationId_fkey")

  @@map("AuditLogChain")
}

model AuthChallenge {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  purpose        String
  method         String
  codeHash       String
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AuthChallenge_organizationId_fkey")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "AuthChallenge_userId_fkey")

  @@index([organizationId, expiresAt], map: "AuthChallenge_organizationId_expiresAt_idx")
  @@index([organizationId, userId, purpose, createdAt], map: "AuthChallenge_organizationId_userId_purpose_createdAt_idx")
  @@index([userId], map: "AuthChallenge_userId_fkey")
  @@map("AuthChallenge")
}

model AuthEvent {
  id              String       @id @default(cuid())
  organizationId  String
  userId          String?
  emailAttempted  String?
  eventType       String
  status          String
  reasonCode      String?
  ipAddress       String?
  userAgent       String?      @db.Text
  deviceName      String?
  locationState   String?
  locationCountry String?
  occurredAt      DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "AuthEvent_organizationId_fkey")
  user            User?        @relation(fields: [userId], references: [id], map: "AuthEvent_userId_fkey")

  @@index([organizationId, occurredAt], map: "AuthEvent_organizationId_occurredAt_idx")
  @@index([organizationId, status, occurredAt], map: "AuthEvent_organizationId_status_occurredAt_idx")
  @@index([organizationId, userId, occurredAt], map: "AuthEvent_organizationId_userId_occurredAt_idx")
  @@index([userId], map: "AuthEvent_userId_fkey")
  @@map("AuthEvent")
}

model BillingFeature {
  id                 String               @id @default(cuid())
  key                String               @unique(map: "BillingFeature_key_key")
  name               String
  normalizedName     String
  description        String?              @db.Text
  moduleKey          String?
  status             String               @default("ACTIVE")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  billingplanfeature BillingPlanFeature[]

  @@unique([moduleKey, normalizedName], map: "BillingFeature_moduleKey_normalizedName_key")
  @@index([moduleKey, status], map: "BillingFeature_moduleKey_status_idx")
  @@map("BillingFeature")
}

model BillingHistory {
  id             String       @id @default(cuid())
  organizationId String
  description    String
  amount         Decimal      @db.Decimal(14, 2)
  currency       String       @default("NGN")
  status         String
  billedAt       DateTime
  providerRef    String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "BillingHistory_organizationId_fkey")

  @@index([organizationId, billedAt], map: "BillingHistory_organizationId_billedAt_idx")
  @@index([organizationId, status, billedAt], map: "BillingHistory_organizationId_status_billedAt_idx")
  @@index([status, billedAt], map: "BillingHistory_status_billedAt_idx")
  @@map("BillingHistory")
}

model BillingNotification {
  id             String       @id @default(cuid())
  organizationId String
  type           String
  renewalDate    DateTime
  scheduledFor   DateTime
  channels       Json
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  errorMessage   String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "BillingNotification_organizationId_fkey")

  @@unique([organizationId, type, renewalDate], map: "BillingNotification_organizationId_type_renewalDate_key")
  @@index([status, scheduledFor], map: "BillingNotification_status_scheduledFor_idx")
  @@map("BillingNotification")
}

model BillingPlanFeature {
  planId    String
  featureId String
  createdAt DateTime           @default(now())
  feature   BillingFeature     @relation(fields: [featureId], references: [id], map: "BillingPlanFeature_featureId_fkey")
  plan      BillingProductPlan @relation(fields: [planId], references: [id], onDelete: Cascade, map: "BillingPlanFeature_planId_fkey")

  @@id([planId, featureId])
  @@index([featureId], map: "BillingPlanFeature_featureId_idx")
  @@map("BillingPlanFeature")
}

model BillingPlanModule {
  planId    String
  moduleKey String
  createdAt DateTime           @default(now())
  plan      BillingProductPlan @relation(fields: [planId], references: [id], onDelete: Cascade, map: "BillingPlanModule_planId_fkey")

  @@id([planId, moduleKey])
  @@index([moduleKey], map: "BillingPlanModule_moduleKey_idx")
  @@map("BillingPlanModule")
}

model BillingPriceVersion {
  id              String                       @id @default(cuid())
  planId          String
  monthlyPrice    Decimal                      @db.Decimal(14, 2)
  currency        String                       @default("NGN")
  effectiveAt     DateTime
  endsAt          DateTime?
  reason          String?                      @db.Text
  changedByUserId String?
  version         Int
  createdAt       DateTime                     @default(now())
  plan            BillingProductPlan           @relation(fields: [planId], references: [id], onDelete: Cascade, map: "BillingPriceVersion_planId_fkey")
  priceAgreements SubscriptionPriceAgreement[]

  @@unique([planId, version], map: "BillingPriceVersion_planId_version_key")
  @@index([effectiveAt, endsAt], map: "BillingPriceVersion_effectiveAt_endsAt_idx")
  @@index([planId, effectiveAt], map: "BillingPriceVersion_planId_effectiveAt_idx")
  @@map("BillingPriceVersion")
}

model BillingProductPlan {
  id              String                       @id @default(cuid())
  key             String                       @unique(map: "BillingProductPlan_key_key")
  name            String
  normalizedName  String                       @unique(map: "BillingProductPlan_normalizedName_key")
  description     String                       @db.Text
  status          String                       @default("ACTIVE")
  pricingModel    String                       @default("FLAT_MONTHLY")
  isSystem        Boolean                      @default(false)
  rowVersion      Int                          @default(1)
  createdByUserId String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  features        BillingPlanFeature[]
  modules         BillingPlanModule[]
  prices          BillingPriceVersion[]
  priceAgreements SubscriptionPriceAgreement[]

  @@index([status, updatedAt], map: "BillingProductPlan_status_updatedAt_idx")
  @@map("BillingProductPlan")
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String       @db.Text
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Branch_organizationId_fkey")

  @@unique([organizationId, name], map: "Branch_organizationId_name_key")
  @@index([organizationId], map: "Branch_organizationId_idx")
  @@map("Branch")
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?      @db.Text
  taxId          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Client_organizationId_fkey")
  invoice        Invoice[]

  @@index([organizationId], map: "Client_organizationId_idx")
  @@map("Client")
}

model ConductLog {
  id                     String           @id @default(cuid())
  organizationId         String
  employeeId             String
  category               String
  summary                String
  details                String?          @db.Text
  type                   String           @default("QUERY")
  status                 String           @default("IN_PROGRESS")
  notes                  String?          @db.Text
  durationValue          Int?
  durationUnit           String?
  startDate              DateTime?
  endDate                DateTime?
  previousEmployeeStatus employee_status?
  createdById            String?
  resolvedById           String?
  resolvedAt             DateTime?
  incidentDate           DateTime
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  employee               Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "ConductLog_employeeId_fkey")

  @@index([employeeId], map: "ConductLog_employeeId_fkey")
  @@index([organizationId, employeeId], map: "ConductLog_organizationId_employeeId_idx")
  @@index([organizationId, type, status], map: "ConductLog_org_type_status_idx")
  @@index([organizationId, createdAt], map: "ConductLog_org_created_idx")
  @@map("ConductLog")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  headEmployeeId String?
  headEmployee   Employee?    @relation("department_headEmployeeIdToemployee", fields: [headEmployeeId], references: [id], map: "Department_headEmployeeId_fkey")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Department_organizationId_fkey")
  employees      Employee[]   @relation("employee_departmentIdTodepartment")
  team           Team[]

  @@unique([organizationId, name], map: "Department_organizationId_name_key")
  @@index([headEmployeeId], map: "Department_headEmployeeId_idx")
  @@index([organizationId], map: "Department_organizationId_idx")
  @@map("Department")
}

model Employee {
  id                    String                    @id @default(cuid())
  organizationId        String
  departmentId          String?
  teamId                String?
  employeeNo            String
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  jobTitle              String?
  hireDate              DateTime?
  status                employee_status           @default(ACTIVE)
  baseSalary            Decimal?                  @db.Decimal(14, 2)
  bankName              String?
  bankAccountNumber     String?
  bankAccountName       String?
  bankAccountType       String?
  pensionPin            String?
  lifecycleStatus       employee_lifecycle_status @default(PROBATION)
  lifecycleEffectiveAt  DateTime?
  gender                String?
  employmentType        String?
  dateOfBirth           DateTime?
  address               String?                   @db.Text
  city                  String?
  nationality           String?
  state                 String?
  workMode              String?
  maritalStatus         String?
  taxId                 String?
  bankCode              String?
  profileImageUrl       String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinAddress      String?                   @db.Text
  nextOfKinRelationship String?
  guarantorFirstName    String?
  guarantorLastName     String?
  guarantorRelationship String?
  guarantorPhone        String?
  guarantorAddress      String?                   @db.Text
  managerId             String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  attendance            Attendance[]
  attendanceDisputes    AttendanceDispute[]
  conductlog            ConductLog[]
  headedDepartments     Department[]              @relation("department_headEmployeeIdToemployee")
  department            Department?               @relation("employee_departmentIdTodepartment", fields: [departmentId], references: [id], map: "Employee_departmentId_fkey")
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "Employee_organizationId_fkey")
  team                  Team?                     @relation(fields: [teamId], references: [id], map: "Employee_teamId_fkey")
  leaverequest          LeaveRequest[]
  loans                 LoanAdvance[]
  payslip               Payslip[]
  salaryStructures      SalaryStructure[]
  user                  User?
  documents             EmployeeDocument[]
  statusHistory         EmployeeStatusHistory[]
  manager               Employee?                 @relation("EmployeeManager", fields: [managerId], references: [id], map: "Employee_managerId_fkey")
  directReports         Employee[]                @relation("EmployeeManager")
  employeeAppraisals    EmployeeAppraisal[]       @relation("EmployeeAppraisalEmployee")
  managedAppraisals     EmployeeAppraisal[]       @relation("EmployeeAppraisalManager")
  bankUpdateRequests    BankDetailsUpdateRequest[]

  @@unique([organizationId, email], map: "Employee_organizationId_email_key")
  @@unique([organizationId, employeeNo], map: "Employee_organizationId_employeeNo_key")
  @@index([departmentId], map: "Employee_departmentId_fkey")
  @@index([organizationId], map: "Employee_organizationId_idx")
